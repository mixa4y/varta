{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varta.local/schemas/map-data.schema.json",
  "title": "VARTA Evidence Map snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "export",
    "case",
    "proceedings",
    "documents",
    "events",
    "relations",
    "inventory"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "export": {
      "type": "object",
      "required": ["exportId", "generatedAt", "profile"],
      "properties": {
        "exportId": {"type": "string", "minLength": 1},
        "generatedAt": {"type": ["string", "null"], "format": "date-time"},
        "profile": {"type": "string", "minLength": 1},
        "productVersion": {"type": "string"},
        "sourceSnapshotSha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "case": {"$ref": "#/$defs/case"},
    "proceedings": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "inventory": {"type": "object"}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "number", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "number": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "subtitle": {"type": "string"},
        "caseIds": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "proceedingIds": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "sourceReferences": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "classification": {"$ref": "#/$defs/classification"},
        "reviewStatus": {"type": "string"},
        "map": {
          "type": "object",
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["id", "fromId", "toId", "relationType", "classification", "reviewStatus"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fromId": {"type": "string", "minLength": 1},
        "toId": {"type": "string", "minLength": 1},
        "relationType": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "basisDocumentIds": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "sourceReferences": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "classification": {"$ref": "#/$defs/classification"},
        "reviewStatus": {"type": "string", "minLength": 1},
        "uncertaintyNote": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {"const": "confirmed_fact"}
            },
            "required": ["classification"]
          },
          "then": {
            "anyOf": [
              {"required": ["basisDocumentIds"]},
              {"required": ["sourceReferences"]}
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "classification": {
      "type": "string",
      "enum": [
        "confirmed_fact",
        "party_position",
        "user_position",
        "court_reasoning",
        "legal_conclusion",
        "contradiction",
        "open_question",
        "unverified"
      ]
    }
  },
  "additionalProperties": false
}
